{
  "name": "@dogear/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:workers": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "db:migrate:local": "wrangler d1 migrations apply dogear_prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply dogear_prod --remote",
    "db:verify-schema": "bun run scripts/verify-schema-parity.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@dogear/db": "workspace:*",
    "@dogear/shared": "workspace:*",
    "csv-parse": "^5.5.5",
    "csv-stringify": "^6.4.5",
    "drizzle-orm": "^0.38.3",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "metascraper": "^5.56.2",
    "metascraper-author": "^5.56.2",
    "metascraper-date": "^5.56.2",
    "metascraper-description": "^5.56.2",
    "metascraper-image": "^5.56.2",
    "metascraper-logo": "^5.56.2",
    "metascraper-title": "^5.56.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.42.0"
  }
}
